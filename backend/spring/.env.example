# Configuração do PostgreSQL (Neon Cloud ou Local)
#
# Para conexão com o banco Neon Cloud:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-hostname>:5432/<dbname>?sslmode=require&channelbinding=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=<sua-senha>
#
# Conexão padrão local:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gestao_academia
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
GOOGLE_CLIENT_IDS=
ACADEMIA_PERSONAL_EMAIL=
